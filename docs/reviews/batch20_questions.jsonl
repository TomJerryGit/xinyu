{"classic_id": "adv_17065", "title": "静夜思", "type": "简答", "cognitive": "理解", "question": "“疑是地上霜”中的“疑”是什么意思？这一句写出了月光怎样的特点？", "answer": "“疑”是好像、仿佛。月光皎洁、清冷，洒在床前，让人误以为地上铺了一层白霜。", "explanation": "抓住“疑”的释义和月光清冷皎洁的特点。", "rubric": [{"dimension": "信息准确", "points": 60, "criteria": "释义和月光特点都答对"}, {"dimension": "语言表达", "points": 40, "criteria": "表述通顺、完整"}], "queue_id": 345, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_17065", "title": "静夜思", "type": "简答", "cognitive": "分析", "question": "诗中“举头”“低头”两个动作的顺序能否互换？结合全诗说明理由。", "answer": "不能。先“举头”望月，才由明月触发“低头”思乡；动作有因果和情感递进。互换后，望月这一触发点消失，情感逻辑断裂。", "explanation": "动作顺序与情感触发、递进相关。", "rubric": [{"dimension": "观点明确", "points": 30, "criteria": "明确判断不能互换"}, {"dimension": "原文依据", "points": 40, "criteria": "结合“举头”“低头”说明因果"}, {"dimension": "分析深度", "points": 30, "criteria": "指出望月触发思乡的情感逻辑"}], "queue_id": 346, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_76544", "title": "春晓", "type": "简答", "cognitive": "理解", "question": "诗人从哪些感官写春晨？请结合诗句说明。", "answer": "主要写听觉：“处处闻啼鸟”“夜来风雨声”；还写春睡的感觉：“春眠不觉晓”。由鸟啼、风雨声和睡意写出春晨。", "explanation": "区分听觉与感觉，不要泛泛说“写景”。", "rubric": [{"dimension": "信息准确", "points": 60, "criteria": "指出听觉和春睡感觉，并引诗句"}, {"dimension": "语言表达", "points": 40, "criteria": "条理清楚"}], "queue_id": 347, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_76544", "title": "春晓", "type": "简答", "cognitive": "分析", "question": "“花落知多少”表达了什么情感？它是直接抒情吗？请分析。", "answer": "表达惜春之情。诗人没有直说惋惜，而是用“知多少”的疑问和想象写落花，含蓄写出对春光流逝的怜惜。", "explanation": "注意疑问句和含蓄抒情。", "rubric": [{"dimension": "观点明确", "points": 30, "criteria": "点出惜春"}, {"dimension": "原文依据", "points": 40, "criteria": "结合“知多少”的疑问/想象"}, {"dimension": "分析深度", "points": 30, "criteria": "说明含蓄抒情的效果"}], "queue_id": 348, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_82609", "title": "登鹳雀楼", "type": "简答", "cognitive": "理解", "question": "“白日依山尽，黄河入海流”描绘了怎样的画面？", "answer": "夕阳依着群山慢慢落下，黄河奔腾流向大海。前句写日落，后句写大河奔流，一静一动、一近一远，景象雄浑开阔。", "explanation": "抓住落日、群山、黄河、大海等意象。", "rubric": [{"dimension": "信息准确", "points": 60, "criteria": "画面要素完整"}, {"dimension": "语言表达", "points": 40, "criteria": "描述有画面感、通顺"}], "queue_id": 349, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_82609", "title": "登鹳雀楼", "type": "简答", "cognitive": "分析", "question": "“欲穷千里目，更上一层楼”只是写登楼吗？它还表达了什么道理？", "answer": "不只是写登楼。它说明要想看得更远，就要再登高一层；引申为站得高才能看得远，表达积极进取、不断追求更高境界的道理。", "explanation": "由实写登楼上升到哲理。", "rubric": [{"dimension": "观点明确", "points": 30, "criteria": "点出哲理/积极进取"}, {"dimension": "原文依据", "points": 40, "criteria": "结合“穷”“更上”分析"}, {"dimension": "分析深度", "points": 30, "criteria": "说明由景入理"}], "queue_id": 350, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_44378", "title": "江雪", "type": "简答", "cognitive": "理解", "question": "前两句“千山鸟飞绝，万径人踪灭”营造了怎样的环境？", "answer": "千山不见飞鸟，万条小路没有人迹。“绝”“灭”写出天地寂静、寒冷荒凉，营造出空旷、孤寂的环境。", "explanation": "抓住“绝”“灭”和夸张的“千山”“万径”。", "rubric": [{"dimension": "信息准确", "points": 60, "criteria": "概括寂静荒寒，引用关键词"}, {"dimension": "语言表达", "points": 40, "criteria": "表达清楚"}], "queue_id": 351, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_44378", "title": "江雪", "type": "简答", "cognitive": "分析", "question": "“孤舟蓑笠翁，独钓寒江雪”塑造了怎样的渔翁形象？寄托了诗人什么情感？", "answer": "塑造了一个在冰天雪地中独自垂钓的孤高渔翁形象。他不畏严寒、不与世俗同流，寄托诗人被贬后孤傲不屈、坚守理想的情怀。", "explanation": "由形象到寄托，注意“孤”“独”。", "rubric": [{"dimension": "观点明确", "points": 30, "criteria": "概括孤高不屈"}, {"dimension": "原文依据", "points": 40, "criteria": "结合孤舟、独钓、寒江雪"}, {"dimension": "分析深度", "points": 30, "criteria": "联系诗人处境/寄托"}], "queue_id": 352, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_96244", "title": "鹿柴", "type": "简答", "cognitive": "理解", "question": "“空山不见人，但闻人语响”用了什么手法写山林？", "answer": "用以声衬静（以动衬静）的手法。空山看不见人，却传来人语声，声音反而衬托出山林的幽静。", "explanation": "手法+效果。", "rubric": [{"dimension": "信息准确", "points": 60, "criteria": "指出以声衬静"}, {"dimension": "语言表达", "points": 40, "criteria": "说明声音与幽静的关系"}], "queue_id": 353, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
{"classic_id": "adv_96244", "title": "鹿柴", "type": "简答", "cognitive": "分析", "question": "“返景入深林，复照青苔上”中的光影描写有什么作用？", "answer": "夕阳余晖射入深林，又照在青苔上。微弱的光影与幽暗的深林形成对比，进一步写出山林的幽静、空寂，带有禅意。", "explanation": "光影、色彩与幽静意境。", "rubric": [{"dimension": "观点明确", "points": 30, "criteria": "点出幽静/禅意"}, {"dimension": "原文依据", "points": 40, "criteria": "结合返景、深林、青苔"}, {"dimension": "分析深度", "points": 30, "criteria": "说明光影对比的作用"}], "queue_id": 354, "review_minutes": "", "decision": "pending", "reviewer": "", "edited": "", "edited_question": "", "edited_answer": "", "notes": ""}
